# QR-Based Smart Attendance Management System — Backend

# ============================================================
# Environment Variables (copy to .env and fill in real values)
# ============================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key

# JWT
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret

# Database Options:
# 1. Supabase PostgreSQL (Production / Direct connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# 2. Supabase Connection Pooler (Transaction pooler, port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# 3. Local MySQL (Development):
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/attendance_system
# Or keep MYSQL_DATABASE_URL=... as a fallback

# Initial Admin Account Provisioning (Used by seed_admin.py)
ADMIN_EMAIL=admin@institution.edu
ADMIN_PASSWORD=your-secure-admin-password

# Resend Email API (Recommended for Cloud Hosting / Render)
RESEND_API_KEY=
EMAIL_FROM=QR Attendance System <onboarding@resend.dev>

# Legacy Gmail SMTP (Optional fallback)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# OTP Security
OTP_HMAC_SECRET=change-this-to-a-random-hmac-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
